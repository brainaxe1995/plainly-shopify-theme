<section class="page-grid section-y">
  <div class="text-column">
    <p class="eyebrow">Blog</p>
    <h1 class="heading mt-4">{{ blog.title }}</h1>
    <div class="rule-hard mt-8 pt-8 space-y-8">
      {% for article in blog.articles %}
        <article>
          <a href="{{ article.url }}"><h2 class="subheading">{{ article.title }}</h2></a>
          <p class="mt-2 text-muted-foreground">{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
