<section class="page-grid section-y">
  <div class="text-column">
    <p class="eyebrow">Your bag</p>
    <h1 class="heading mt-4">{% if cart.item_count > 0 %}{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}{% else %}Empty bag{% endif %}</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="rule-hard mt-8 pt-8">
        {% for item in cart.items %}
          <div class="flex items-start gap-4 border-b border-border py-6">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="size-24 rounded-md border border-border object-cover">
            {% endif %}
            <div class="flex-1 min-w-0">
              <a href="{{ item.url }}" class="subheading">{{ item.product.title }}</a>
              {% if item.variant.title != 'Default Title' %}<p class="text-[14px] text-muted-foreground">{{ item.variant.title }}</p>{% endif %}
              <p class="mt-2 text-[16px] tabular-nums">{{ item.final_line_price | money }}</p>
              <div class="mt-3 flex items-center gap-3">
                <label class="text-[13px] uppercase tracking-[0.06em] text-muted-foreground">Qty</label>
                <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" class="w-16 rounded-md border border-border bg-background px-2 py-1">
              </div>
            </div>
          </div>
        {% endfor %}
        <div class="flex items-center justify-between border-b border-border py-6">
          <span class="subheading">Subtotal</span>
          <span class="text-[22px] font-semibold text-forest tabular-nums">{{ cart.total_price | money }}</span>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <button type="submit" name="update" class="btn-base btn-outline">Update</button>
          <button type="submit" name="checkout" class="btn-base btn-ink">Checkout</button>
        </div>
      </form>
    {% else %}
      <p class="mt-6 text-muted-foreground">Your bag is empty. <a href="/collections/all" class="underline underline-offset-4">Pick a plan.</a></p>
    {% endif %}
  </div>
</section>
