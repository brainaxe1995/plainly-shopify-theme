<section class="page-grid section-y">
  <div class="text-column">
    <p class="eyebrow">Search</p>
    <h1 class="heading mt-4">{% if search.performed %}{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"{% else %}Search{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" class="mt-6 flex gap-3">
      <input type="text" name="q" value="{{ search.terms }}" placeholder="What are you looking for?" class="flex-1 rounded-md border border-border bg-background px-4 py-3">
      <button type="submit" class="btn-base btn-ink">Search</button>
    </form>
    {% if search.performed %}
      <ul class="mt-8 space-y-4">
        {% for item in search.results %}
          <li><a href="{{ item.url }}" class="subheading hover:underline">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
