<section class="border-t border-border bg-paper">
  <div class="page-grid section-y">
    <div class="text-column">
      <p class="eyebrow">Before you order</p>
      <h2 class="heading mt-4 mb-8">Questions people ask</h2>
      <div class="rule-hard">
        {% for block in section.blocks %}
          <details {% if forloop.first %}open{% endif %} class="group border-b border-foreground/15">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[19px] font-extrabold tracking-[-0.01em]">
              <span>{{ block.settings.q }}</span>
              <span aria-hidden="true" class="mt-1 text-[22px] leading-none font-extrabold text-moss select-none">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">&minus;</span>
              </span>
            </summary>
            <p class="measure pb-6 text-muted-foreground">{{ block.settings.a }}</p>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product FAQ",
  "settings": [],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [ { "type": "text", "id": "q" }, { "type": "textarea", "id": "a" } ] }
  ],
  "default": {
    "blocks": [
      { "type": "qa", "settings": { "q": "Will anyone know what I ordered?", "a": "No. Plain box, no logo on the outside. Your bank statement shows a normal company name. No product name in any email we send you." } },
      { "type": "qa", "settings": { "q": "What is actually in the box?", "a": "Your tablets. One a day. That is it. No course, no app, no homework. Just what our specialist recommends." } },
      { "type": "qa", "settings": { "q": "How fast does it come?", "a": "About 5 days. You get a tracking link when it is sent." } },
      { "type": "qa", "settings": { "q": "Is this a medicine?", "a": "No. It is not a medicine and it does not treat any illness. If you feel out of control, or it is hurting your work or your relationship, please also talk to a doctor." } },
      { "type": "qa", "settings": { "q": "Can I stop the monthly delivery?", "a": "Yes, any time, one click in your account. No calls, no forms, no waiting." } },
      { "type": "qa", "settings": { "q": "What if it does nothing for me?", "a": "Send us one line and you get your money back. You keep the box. We would rather refund you than keep money from a man we did not help." } },
      { "type": "qa", "settings": { "q": "Full ingredient list", "a": "Placeholder until the final pack is confirmed: the full list of ingredients and amounts per daily tablet, allergen information and storage instructions go here. You can read this before you pay." } }
    ]
  },
  "presets": [ { "name": "Product FAQ" } ]
}
{% endschema %}
