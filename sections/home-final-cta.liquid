{%- assign starter = settings.starter_price_cents | money -%}
{%- assign ship_over = settings.free_shipping_over_cents | money -%}
{%- assign buy_url = section.settings.cta_url | default: '/pages/buy' -%}
<section class="page-grid section-y text-center">
  <div class="text-column">
    <h2 class="heading">{{ section.settings.headline_pre }} {{ starter }}.</h2>
    <p class="mt-3 text-muted-foreground">From {{ starter }}. Free shipping over {{ ship_over }}. 60 nights or your money back. Stop any time.</p>
    <a href="{{ buy_url }}" class="btn-base btn-ink mt-6">{{ section.settings.cta_label }}</a>
    <p class="mt-4 text-[14px] text-muted-foreground">Or write to us first at {{ settings.support_email }}. We answer.</p>
  </div>
</section>

{% schema %}
{
  "name": "Home final CTA",
  "settings": [
    { "type": "text", "id": "headline_pre", "label": "Headline · before price", "default": "You already know how tonight ends. Change it for" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Start tonight" },
    { "type": "url", "id": "cta_url", "label": "CTA URL (default: /pages/buy)" }
  ]
}
{% endschema %}
