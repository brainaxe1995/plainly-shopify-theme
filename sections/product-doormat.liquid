<section class="border-y border-border bg-paper">
  <div class="page-grid section-y">
    <div class="text-column">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image_alt }}" class="w-full rounded-[4px] border border-border object-cover" style="aspect-ratio: 1 / 1;" loading="lazy">
      {% else %}
        <div class="photo-slot" style="aspect-ratio: 1 / 1;" role="img" aria-label="{{ section.settings.image_alt }}"><span>{{ section.settings.image_alt }}</span></div>
      {% endif %}
      <p class="eyebrow mt-10">What arrives at your door</p>
      <h2 class="heading mt-4">Your girlfriend could open it. She'd learn nothing.</h2>
      <p class="measure mt-4 text-muted-foreground">One plain box. No logo, no window, no product name, no branded tape. Whoever takes it in learns nothing. Your statement shows a normal company name.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product doormat",
  "settings": [
    { "type": "image_picker", "id": "image" },
    { "type": "text", "id": "image_alt", "default": "Photo · the plain outer box, as it lands" }
  ],
  "presets": [ { "name": "Product doormat" } ]
}
{% endschema %}
