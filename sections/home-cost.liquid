{%- assign starter = settings.starter_price_cents | money -%}
{%- assign buy_url = section.settings.cta_url | default: '/pages/buy' -%}
<section class="border-y border-border bg-paper">
  <div class="page-grid section-y">
    <div class="text-column text-center">
      <p class="eyebrow">Nobody wants to do this maths. Do it.</p>
      <h2 class="heading mt-4">One more month of this costs you far more than {{ starter }}.</h2>
    </div>
    <div class="mx-auto mt-12 grid max-w-4xl gap-10 sm:grid-cols-3">
      <div class="text-center">
        <p class="numeral text-forest">30</p>
        <p class="mx-auto mt-3 max-w-[26ch] text-[16px] text-muted-foreground">Thirty more nights that end the same way, if you change nothing.</p>
      </div>
      <div class="text-center">
        <p class="numeral text-forest">2h</p>
        <p class="mx-auto mt-3 max-w-[26ch] text-[16px] text-muted-foreground">What a bad night takes from the next morning. Tired, late, behind.</p>
      </div>
      <div class="text-center">
        <p class="numeral text-forest">{{ section.settings.per_day_note }}</p>
        <p class="mx-auto mt-3 max-w-[26ch] text-[16px] text-muted-foreground">What the biggest box costs per day. Cheaper than your coffee.</p>
      </div>
    </div>
    <div class="mt-12 text-center">
      <a href="{{ buy_url }}" class="btn-base btn-ink">{{ section.settings.cta_label_pre }} {{ starter }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home cost",
  "settings": [
    { "type": "text", "id": "per_day_note", "label": "Per-day cost note (numeral)", "default": "Low" },
    { "type": "text", "id": "cta_label_pre", "label": "CTA · text before price", "default": "Stop the next thirty for" },
    { "type": "url", "id": "cta_url", "label": "CTA URL (default: /pages/buy)" }
  ]
}
{% endschema %}
